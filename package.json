{
  "name": "nagamuster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-exchange-calendar.mjs && node scripts/build-briefings.mjs && node scripts/check-source-graph.mjs && tsc -b && vite build && node scripts/write-build-info.mjs",
    "check:source": "node scripts/check-source-graph.mjs",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "predev": "node scripts/build-briefings.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "verify:all": "npm run verify && npm run test:e2e",
    "setup:browsers": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "calendar:check": "python scripts/build-exchange-calendar.py --check",
    "calendar:generate": "python scripts/build-exchange-calendar.py",
    "check:data": "node scripts/check-data-health.mjs",
    "check:stocks": "node scripts/check-data-health.mjs --stocks-only"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-table": "9.3.1",
    "cheerio": "1.2.0",
    "echarts": "6.1.0",
    "fast-xml-parser": "^5.11.1",
    "fuse.js": "7.5.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.63.0",
    "motion": "14.3.0",
    "pretendard": "1.3.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.5",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "30.1.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
